# Copy this file to .env.local for local development.
# Configure production values in Railway. Never commit real credentials or tokens.

# ─── Required: public browser configuration ───
# Every VITE_* value is embedded in the browser bundle and must never contain a secret.
VITE_BASE_URL=https://milkandhenny.com
VITE_MEDIA_PUBLIC_URL=https://pics.milkandhenny.com

# ─── Required: Cloudflare R2 object storage ───
# Use independent tokens. Scope each token to one bucket with Object Read & Write.
R2_ACCOUNT_ID=
R2_PUBLIC_BUCKET=milkandhenny-pics
R2_PUBLIC_ACCESS_KEY=
R2_PUBLIC_SECRET_KEY=
R2_PRIVATE_BUCKET=milkandhenny-private
R2_PRIVATE_ACCESS_KEY=
R2_PRIVATE_SECRET_KEY=

# ─── Required: authentication ───
# AUTH_SECRET must contain at least 32 characters. Generate one with: openssl rand -hex 32
AUTH_SECRET=
# Use independent values for each gate. ADMIN_PASSWORD and UPLOAD_PIN must contain at least 12 characters.
STAFF_PIN=
ADMIN_PASSWORD=
UPLOAD_PIN=

# ─── Required: Postgres application state and durable work ───
# On Railway, use a scoped database login rather than the Postgres owner URL.
# Run migrations separately, then set DATABASE_SCHEMA_MODE=verify for restricted runtimes.
DATABASE_URL=
# DATABASE_POOL_MAX=8
# DATABASE_SCHEMA_MODE=verify
# Production uses all of the following Postgres selectors. Set them together for a
# Redis-free deployment after migrations and source imports are complete.
# Authentication and attendee state:
# AUTH_TOKEN_STORE=postgres
# AUTH_CLI_STORE=postgres
# ATTENDEE_SESSION_STORE=postgres
# PASSKEY_CEREMONY_STORE=postgres
# UPLOAD_ACCESS_STORE=postgres
# RATE_LIMIT_STORE=postgres
# Content and transfers:
# REPORT_STORE=postgres
# BEST_DRESSED_STORE=postgres
# ALBUM_STORE=postgres
# ALBUM_OBJECT_DELETION_RUNNER=postgres
# WORD_STORE=postgres
# WORD_SHARE_STORE=postgres
# TRANSFER_CATALOGUE_STORE=postgres
# TRANSFER_MEDIA_JOB_STORE=postgres
# TRANSFER_MEDIA_EVENT_BACKPLANE=postgres
# TRANSFER_OBJECT_DELETION_RUNNER=postgres
# MEDIA_WORKER_STATUS_STORE=postgres
# Rooms and game coordination:
# MULTIPLAYER_REALTIME_BACKPLANE=postgres
# OFFICIAL_GAME_RESULT_OUTBOX_STORE=postgres
# HOT_AND_COLD_ROOM_STORE=postgres
# SPELLING_PARTY_ROOM_STORE=postgres
# CENTRE_ROOM_STORE=postgres
# TWIN_ROOM_STORE=postgres
# SAME_BRAIN_ROOM_STORE=postgres
# LIARS_ROOM_STORE=postgres
# PAIRED_GAME_ROOM_STORE=postgres
# DRAW_COUNTRY_ROOM_STORE=postgres
# FAMILY_FEUD_ROOM_STORE=postgres
# GAME_POOL_CREDENTIAL_STORE=postgres
# PITCH_PRESENTATION_STORE=postgres

# ─── Optional: payments (required to sell paid tickets) ───
# Hosted Stripe Checkout — Apple Pay and Google Pay come free, and no card
# data touches this codebase. Free tickets work without any of this.
#
# STRIPE_WEBHOOK_SECRET comes from the endpoint you create at
# https://dashboard.stripe.com/webhooks pointing at
# https://milkandhenny.com/api/stripe/webhook, subscribed to:
#   checkout.session.completed, checkout.session.async_payment_succeeded,
#   checkout.session.async_payment_failed, checkout.session.expired,
#   charge.refunded, refund.created, refund.updated, refund.failed,
#   charge.dispute.created, charge.dispute.closed,
#   radar.early_fraud_warning.created
#
# The webhook is what issues paid tickets — the success redirect is only a
# courtesy, because people close the tab.
# Use a least-privilege restricted key, not the account-wide secret key.
# It needs write access to Checkout Sessions and Refunds, and read access to
# PaymentIntents and Refunds.
# STRIPE_SECRET_KEY=rk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Optional: transactional email (required before issuing tickets) ───
# Send from a DEDICATED SUBDOMAIN (e.g. tickets.milkandhenny.com) with SPF, DKIM
# and DMARC configured. Bulk or announcement mail must not share this domain:
# spam complaints from bulk sending damage the reputation of the domain that
# carries someone's entry to an event.
#
# Use an API token scoped to email sending only — never a global key, and never
# the R2 credentials. EMAIL_ACCOUNT_ID falls back to R2_ACCOUNT_ID if unset.
# EMAIL_API_KEY=
# EMAIL_TICKETS_FROM=tickets@tickets.milkandhenny.com
# EMAIL_STUDIO_FROM=studio@notify.milkandhenny.com
# EMAIL_COMMUNICATIONS_FROM=events@notify.milkandhenny.com
# EMAIL_ACCESS_FROM=access@notify.milkandhenny.com
# EMAIL_OPERATIONS_FROM=alerts@notify.milkandhenny.com
# EMAIL_REPLY_TO=hello@milkandhenny.com
# EMAIL_ACCOUNT_ID=
# Shared only with the Cloudflare Queue consumer that relays Email Sending
# bounce and complaint events to /api/email/events/cloudflare.
# Generate with: openssl rand -hex 32
# EMAIL_EVENT_SECRET=

# ─── Optional: manual maintenance routes ───
# CRON_SECRET protects manual recovery endpoints; the web scheduler runs automatically.
# Generate CRON_SECRET with: openssl rand -hex 32
# CRON_SECRET=
# Emergency stop for all app-owned scheduled jobs. Leave unset normally.
# APP_SCHEDULER_DISABLED=false

# ─── Optional: media processing ───
# Safe defaults are shown. Configure worker values only after deploying the media worker.
# MEDIA_PROCESSOR_MODE=local
# VITE_TRANSFER_MEDIA_BROWSER_PREP=auto # auto | off
# TRANSFER_MEDIA_WAKE_URL=https://worker.example.com/wake
# TRANSFER_MEDIA_WAKE_TOKEN=
# MEDIA_WORKER_CONCURRENCY=1
# MEDIA_WORKER_ERROR_BACKOFF_MS=15000
# MEDIA_WORKER_HEARTBEAT_INTERVAL_MS=300000
# MEDIA_WORKER_DEPLOYMENT_ID= # optional stable release identifier; defaults to Railway's deployment ID
# MEDIA_RECONCILE_INTERVAL_MS=900000
# MEDIA_WORKER_JOB_TIMEOUT_MS=600000
# MEDIA_INLINE_PROCESSING_TIMEOUT_MS=120000
# MEDIA_VIDEO_POSTER_MAX_BYTES=2147483648

# ─── Optional: external multi-file ZIP service ───
# VITE_MULTI_FILE_ZIP_MODE=auto # auto | client
# VITE_MULTI_FILE_ZIP_URL=https://zip-worker.example.com

# ─── Optional: storage and CLI tuning ───
# Defaults are normally appropriate and may be omitted.
# R2_RETRIES=4
# R2_RETRY_BASE_DELAY_MS=400
# R2_MAX_SOCKETS=50
# R2_SOCKET_ACQUISITION_WARNING_TIMEOUT_MS=10000
# MH_CLI_IO_CONCURRENCY=8

# ─── Optional: runtime metadata shown by /api/health ───
# APP_ENV=development
# APP_VERSION=0.1.0
# Platform-neutral overrides. APP_INSTANCE_ID must be unique per running process/replica.
# Railway metadata and HOSTNAME are accepted automatically when these are omitted.
# APP_COMMIT_SHA=
# APP_INSTANCE_ID=

# Pitch Night studio
# Hard safety ceiling: enabled | read-only | off.
# The admin control cannot make the studio less restrictive than this value.
# PITCHES_MODE=enabled
# PITCH_MAX_SLIDES=6
# PITCH_MAX_DECKS_PER_EMAIL=3
# PITCH_DRAFT_TTL_HOURS=48
