{
  "rules": [
    {
      "allowed": {
        "origins": ["https://milkandhenny.com", "https://www.milkandhenny.com"],
        "methods": ["GET", "HEAD", "PUT"],
        "headers": ["Cache-Control", "Content-Disposition", "Content-Type", "Range"]
      },
      "exposeHeaders": ["Content-Length", "Content-Range", "ETag"],
      "maxAgeSeconds": 3600
    }
  ]
}
