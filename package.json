{
  "name": "milkandhenny.com",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "audio:spelling": "tsx scripts/generate-party-spelling-audio.ts",
    "predev": "node scripts/copy-excalidraw-fonts.mjs",
    "dev": "vite dev",
    "prebuild": "node scripts/copy-excalidraw-fonts.mjs",
    "build": "vite build",
    "start": "node .output/server/index.mjs",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "cli": "tsx --tsconfig tsconfig.cli.json scripts/cli.ts",
    "maintenance": "node ops/run-maintenance.mjs",
    "worker:media": "tsx --tsconfig tsconfig.cli.json scripts/media-worker.ts",
    "typecheck": "tsgo --noEmit",
    "typecheck:ci": "tsgo --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.988.0",
    "@aws-sdk/s3-request-presigner": "^3.990.0",
    "@excalidraw/excalidraw": "0.18.1",
