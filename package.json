    "@types/react-dom": "^19",
    "@types/three": "0.185.0",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "@vitejs/plugin-react": "^5.1.4",
    "onnxruntime-node": "^1.24.1",
    "oxfmt": "^0.59.0",
    "oxlint": "^1.74.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "vite": "^7.2.4",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.0.18",
    "workbox-core": "^7.4.1",
    "workbox-routing": "^7.4.1"
  },
  "packageManager": "pnpm@11.17.0"
