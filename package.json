    "@tanstack/react-start": "^1.168.28",
    "@upstash/redis": "^1.36.2",
    "drawesome": "^0.1.0",
    "effect": "4.0.0-beta.99",
    "exif-reader": "^2.0.3",
    "exifr": "^7.1.3",
    "gray-matter": "^4.0.3",
    "gsap": "3.15.0",
    "ioredis": "^5.8.1",
    "jszip": "^3.10.1",
    "libheif-js": "^1.19.8",
    "nitro": "3.0.260610-beta",
    "papaparse": "^5.5.3",
    "pdfjs-dist": "6.1.200",
    "pg": "^8.22.0",
    "qrcode": "^1.5.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "stripe": "^22.3.2",
    "three": "0.185.1",
    "torph": "0.0.9",
