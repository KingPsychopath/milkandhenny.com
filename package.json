{
  "name": "milkandhenny.com",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "audio:spelling": "tsx scripts/generate-party-spelling-audio.ts",
    "calibrate:same-brain": "tsx --tsconfig tsconfig.cli.json scripts/same-brain-calibrate.ts",
    "model:same-brain": "tsx --tsconfig tsconfig.cli.json scripts/fetch-same-brain-model.ts",
    "predev": "node scripts/copy-excalidraw-fonts.mjs",
    "dev": "vite dev",
    "prebuild": "node scripts/copy-excalidraw-fonts.mjs",
    "og:cards": "node scripts/generate-og-cards.mjs",
    "media:event-arrival": "node scripts/generate-event-arrival-gif.mjs",
    "media:email-mascots": "node scripts/generate-email-mascot-media.mjs",
    "event-scoring:print": "python3 scripts/event-scoring-print.py",
    "build": "node --max-old-space-size=6144 node_modules/vite/bin/vite.js build",
    "start": "node .output/server/index.mjs",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "check": "pnpm format:check && pnpm typecheck && pnpm lint",
    "cli": "tsx --tsconfig tsconfig.cli.json scripts/cli.ts",
    "maintenance": "node ops/run-maintenance.mjs",
    "email:local": "docker compose -f docker-compose.local.yml up -d mailpit",
    "email:local:stop": "docker compose -f docker-compose.local.yml down",
    "email:local:logs": "docker compose -f docker-compose.local.yml logs -f mailpit",
    "backup:postgres": "node ops/postgres-archive.mjs backup",
    "restore:postgres": "node ops/postgres-archive.mjs restore",
    "worker:media": "tsx --tsconfig tsconfig.cli.json scripts/media-worker.ts",
    "typecheck": "tsgo --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run __tests__/unit",
    "test:integration": "vitest run __tests__/integration",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify:release": "pnpm check && pnpm test:coverage && pnpm test:e2e && pnpm build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1109.0",
    "@aws-sdk/s3-request-presigner": "^3.1109.0",
    "@excalidraw/excalidraw": "0.18.1",
    "@huggingface/transformers": "^4.2.0",
    "@smithy/node-http-handler": "^4.10.0",
    "@tanstack/react-router": "^1.170.27",
    "@tanstack/react-start": "^1.168.44",
    "@upstash/redis": "^1.38.2",
    "drawesome": "^0.1.1",
    "effect": "4.0.0-beta.99",
    "exif-reader": "^2.0.3",
    "exifr": "^7.1.3",
    "gray-matter": "^4.0.3",
    "gsap": "3.15.0",
    "ioredis": "^5.11.1",
    "jsqr": "^1.4.0",
    "jszip": "^3.10.1",
    "libheif-js": "^1.19.8",
    "mediabunny": "^1.55.2",
    "nitro": "3.0.260610-beta",
    "papaparse": "^5.6.0",
    "pdfjs-dist": "6.2.108",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "stripe": "^22.5.0",
    "three": "0.185.1",
    "torph": "0.0.9",
    "web-haptics": "0.0.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20.19.43",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.21.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "0.185.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "@xmldom/xmldom": "0.9.12",
    "onnxruntime-node": "^1.27.0",
    "oxfmt": "^0.59.0",
    "oxlint": "^1.78.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "vite": "^7.3.6",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10",
    "workbox-core": "^7.4.1",
    "workbox-routing": "^7.4.1"
  },
  "packageManager": "pnpm@11.17.0"
}
